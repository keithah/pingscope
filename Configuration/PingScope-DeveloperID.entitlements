<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime enabled, sandbox disabled for ICMP -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Hardened runtime: disable unsigned executable memory -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>

	<!-- Hardened runtime: disable environment variables -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<false/>

	<!-- CloudKit outside the App Store needs the app identity spelled out;
	     App Store signing injects these but Developer ID signing does not,
	     and without them CKContainer.default() resolves nil and throws. -->
	<key>com.apple.application-identifier</key>
	<string>6R7S5GA944.com.hadm.PingScope</string>
	<key>com.apple.developer.team-identifier</key>
	<string>6R7S5GA944</string>

	<!-- Opt-in history and host sync uses only the user's private CloudKit database. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.hadm.PingScope</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Required outside the App Store: CKContainer throws (and CloudKit's
	     dispatch_once makes it uncatchable) when a Developer ID build omits
	     the container environment. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>

	<!-- App Groups for widget data sharing -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6R7S5GA944.group.com.hadm.PingScope</string>
	</array>

	<!-- Network client for TCP/UDP/HTTPS probes -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
